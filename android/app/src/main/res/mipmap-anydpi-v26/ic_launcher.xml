<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon, API 26+ (D130). The ground is the same brand green
     as the launch screen (values/colors.xml). API 24-25 fall back to the
     mipmap-*/ic_launcher.png files, rendered by tool/gen_app_icons.py. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/splash_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
