# Local-only secrets for the Edge Functions. Copy to supabase/.env.local, which
# is gitignored, and fill in a real value.
#
#     cp supabase/.env.local.example supabase/.env.local
#
# supabase/config.toml maps this into [edge_runtime.secrets]. In the hosted
# project the same name is set with:
#
#     supabase secrets set ANTHROPIC_API_KEY=...
#
# CLAUDE.md rule 2: this key never leaves the server. It is read by exactly one
# file, supabase/functions/_shared/ai.ts, and is never passed to the client or
# echoed into a response.
ANTHROPIC_API_KEY=sk-ant-...
